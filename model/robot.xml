  <mujoco model="planar_biped">
  <compiler angle="degree" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <geom contype="1" conaffinity="1" rgba="0.6 0.7 0.9 1"/>
    <default class="leg">
      <joint type="hinge" axis="0 1 0" damping="0.5"/>
    </default>
    <default class="foot">
      <geom contype="1" conaffinity="1" friction="1.0 0.005 0.0001" rgba="0.2 0.2 0.2 1"/>
    </default>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" contype="1" conaffinity="1"
          friction="1.0 0.005 0.0001" rgba="0.8 0.8 0.8 1"/>

    <body name="torso" pos="0 0 0.68">
      <!-- Unactuated planar floating base: x, z, pitch -->
      <joint name="root_x" type="slide" axis="1 0 0"/>
      <joint name="root_z" type="slide" axis="0 0 1"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0"/>
      <geom name="torso_geom" type="box" size="0.07 0.12 0.15" pos="0 0 0.15" mass="8"/>

      <!-- LEFT LEG -->
      <body name="left_thigh" pos="0 0.1 0">
        <joint name="left_hip" class="leg" range="-100 45" armature="0.03"/>
        <geom name="left_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.04" mass="2.5"/>
        <body name="left_shin" pos="0 0 -0.32">
          <joint name="left_knee" class="leg" range="0 140" armature="0.03"/>
          <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.035" mass="1.5"/>
          <body name="left_foot" pos="0 0 -0.32">
            <joint name="left_ankle" class="leg" range="-40 50" armature="0.01"/>
            <geom name="left_foot_geom" class="foot" type="box" size="0.11 0.04 0.03"
                  pos="0.04 0 -0.03" mass="0.6"/>
            <site name="left_foot_site" pos="0.04 0 -0.06" size="0.01"/>
          </body>
        </body>
      </body>

      <!-- RIGHT LEG -->
      <body name="right_thigh" pos="0 -0.1 0">
        <joint name="right_hip" class="leg" range="-100 45" armature="0.03"/>
        <geom name="right_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.04" mass="2.5"/>
        <body name="right_shin" pos="0 0 -0.32">
          <joint name="right_knee" class="leg" range="0 140" armature="0.03"/>
          <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.32" size="0.035" mass="1.5"/>
          <body name="right_foot" pos="0 0 -0.32">
            <joint name="right_ankle" class="leg" range="-40 50" armature="0.01"/>
            <geom name="right_foot_geom" class="foot" type="box" size="0.11 0.04 0.03"
                  pos="0.04 0 -0.03" mass="0.6"/>
            <site name="right_foot_site" pos="0.04 0 -0.06" size="0.01"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_hip_motor"   joint="left_hip"    ctrlrange="-80 80"/>
    <motor name="left_knee_motor"  joint="left_knee"   ctrlrange="-80 80"/>
    <motor name="left_ankle_motor" joint="left_ankle"  ctrlrange="-40 40"/>
    <motor name="right_hip_motor"  joint="right_hip"   ctrlrange="-80 80"/>
    <motor name="right_knee_motor" joint="right_knee"  ctrlrange="-80 80"/>
    <motor name="right_ankle_motor" joint="right_ankle" ctrlrange="-40 40"/>
  </actuator>

  <keyframe>
    <!-- x, z, pitch, L hip/knee/ankle, R hip/knee/ankle (radians) -->
    <key name="stand" qpos="0 0 0 -0.2618 0.5236 -0.2618 -0.2618 0.5236 -0.2618"/>
  </keyframe>
</mujoco>